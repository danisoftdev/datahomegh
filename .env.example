APP_NAME=DataHomeGH
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://datahomegh.shop

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u123456789_datahomegh
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Laravel 11+ uses CACHE_STORE (Laravel 10 used CACHE_DRIVER)
CACHE_STORE=file
CACHE_DRIVER=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@datahomegh.shop"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Paystack (see devrabiul/laravel-paystack / Paystack dashboard)
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PAYMENT_URL=https://api.paystack.co

# Firebase Admin SDK JSON — absolute path on server, e.g. /home/u123456789/datahomegh/storage/app/firebase-credentials.json
# Never commit the real file; upload via SFTP and keep outside public_html or in storage/app (gitignored).
FIREBASE_CREDENTIALS=

# Firebase Web (FCM in browser — Firebase console → Project settings → Your apps → Web app)
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_MEASUREMENT_ID=
# Cloud Messaging → Web Push certificates → Key pair
FIREBASE_WEB_VAPID_PUBLIC_KEY=

# Full WhatsApp URL for admin/support (pending approval page), e.g. https://wa.me/233XXXXXXXXX
ADMIN_WHATSAPP_URL=https://wa.me/

VITE_APP_NAME="${APP_NAME}"
